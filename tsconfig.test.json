{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "vetmax-app",
    "healthmax-app",
    "Orion",
    "Marketing"
  ]
}
