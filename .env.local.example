# VetMax — Variáveis de Ambiente
# BANCO ISOLADO — NÃO compartilhado com o HealthMax
#
# ── ROTA A: Supabase Remoto (recomendada) ──────────────────────────────────
# Crie um NOVO projeto em https://supabase.com/dashboard
# Use credenciais 100% diferentes do projeto HealthMax
#
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF_VETMAX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_vetmax_aqui

# Para rodar migrations via: npm run db:migrate
SUPABASE_ACCESS_TOKEN=seu_personal_access_token
SUPABASE_PROJECT_REF=seu_project_ref_vetmax   # ex: abcdefghijklmnop

# ── ROTA B: Supabase Local (requer Docker Desktop) ─────────────────────────
# Após instalar Docker e rodar: npx supabase start
# O CLI imprimirá os valores abaixo automaticamente
#
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<gerado pelo supabase start>

# ── Anthropic (IA e transcrição por voz) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── URL pública da aplicação ─────────────────────────────────────────────
# Use o IP público ou domínio da instância EC2 (sem barra no final)
# Exemplo: http://54.232.189.113:4000  ou  https://vetmax.suaclinica.com
NEXT_PUBLIC_APP_URL=http://SEU_IP_OU_DOMINIO:4000

# ── Keep-alive Supabase (evita pausa automática do free tier) ────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure o Task Scheduler para chamar GET /api/keepalive?token=<este_valor> a cada 5 dias
KEEPALIVE_SECRET=gere_um_token_seguro_aqui
