# Credenciais da Evolution API — copie para .env e preencha com valores reais
# NUNCA commite o arquivo .env (está no .gitignore)
# Gere senhas seguras com: openssl rand -base64 32

EVOLUTION_POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_32_CHARS
EVOLUTION_REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_32_CHARS
EVOLUTION_API_KEY=TROQUE_POR_CHAVE_FORTE_32_CHARS
